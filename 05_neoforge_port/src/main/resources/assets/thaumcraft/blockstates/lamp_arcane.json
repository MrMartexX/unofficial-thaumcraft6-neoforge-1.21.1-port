{
  "multipart": [
    { "when": { "enabled": "true" }, "apply": { "model": "thaumcraft:block/lamp_arcane_on" } },
    { "when": { "enabled": "false" }, "apply": { "model": "thaumcraft:block/lamp_arcane_off" } },
    { "when": { "facing": "up" }, "apply": { "model": "thaumcraft:block/lamp_stand", "x": 180 } },
    { "when": { "facing": "down" }, "apply": { "model": "thaumcraft:block/lamp_stand" } },
    { "when": { "facing": "north" }, "apply": { "model": "thaumcraft:block/lamp_stand", "x": 90, "y": 180 } },
    { "when": { "facing": "south" }, "apply": { "model": "thaumcraft:block/lamp_stand", "x": 90 } },
    { "when": { "facing": "east" }, "apply": { "model": "thaumcraft:block/lamp_stand", "x": 90, "y": 270 } },
    { "when": { "facing": "west" }, "apply": { "model": "thaumcraft:block/lamp_stand", "x": 90, "y": 90 } }
  ]
}
